# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database
# Host port the Postgres container is published on (docker-compose.yml)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nl_db_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Query execution
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
