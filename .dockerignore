frontend
tests
scripts
chat.py
README.md
docker-compose.yml
prometheus.yml
Dockerfile
.dockerignore

# Python and editor leftovers
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.vscode
.idea
.DS_Store
.claude
